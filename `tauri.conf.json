{
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000"
  },
  "package": {
    "productName": "TauriReactTsApp",
    "version": "1.0.0",
    "description": "A Tauri + React + TypeScript app",
    "copyright": "© 2023 Your Name",
    "authors": ["Your Name"],
    "license": "MIT"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.example.taurireacttsapp",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns"
      ]
    },
    "allowlist": {
      "all": true
    }
  }
}
